# FindSmith
# -------
#
# Finds the Smith library
#
# This will define the following variables:
#
#   SMITH_FOUND        -- True if the system has the Smith library
#   SMITH_INCLUDE_DIRS -- The include directories for smith
#   SMITH_LIBRARIES    -- Libraries to link against
#   SMITH_CXX_FLAGS    -- Additional (required) compiler flags
#
# and the following imported targets:
#
#   smith
macro(append_smithlib_if_found)
  foreach (_arg ${ARGN})
    find_library(${_arg}_LIBRARY ${_arg} PATHS "${SMITH_INSTALL_PREFIX}/lib")
    if(${_arg}_LIBRARY)
      list(APPEND SMITH_LIBRARIES ${${_arg}_LIBRARY})
    else()
      message(WARNING "static library ${${_arg}_LIBRARY} not found.")
    endif()
  endforeach()
endmacro()

macro(append_wholearchive_lib_if_found)
  foreach (_arg ${ARGN})
    find_library(${_arg}_LIBRARY ${_arg} PATHS "${SMITH_INSTALL_PREFIX}/lib")
    if(${_arg}_LIBRARY)
      if(APPLE)
        list(APPEND SMITH_LIBRARIES "-Wl,-force_load,${${_arg}_LIBRARY}")
      elseif(MSVC)
        list(APPEND SMITH_LIBRARIES "-WHOLEARCHIVE:${${_arg}_LIBRARY}")
      else()
        # Linux
        list(APPEND SMITH_LIBRARIES "-Wl,--whole-archive ${${_arg}_LIBRARY} -Wl,--no-whole-archive")
      endif()
    else()
      message(WARNING "static library ${${_arg}_LIBRARY} not found.")
    endif()
  endforeach()
endmacro()

include(FindPackageHandleStandardArgs)

if(DEFINED ENV{SMITH_INSTALL_PREFIX})
  set(SMITH_INSTALL_PREFIX $ENV{SMITH_INSTALL_PREFIX})
else()
  # Assume we are in <install-prefix>/share/cmake/Smith/SmithConfig.cmake
  get_filename_component(CMAKE_CURRENT_LIST_DIR "${CMAKE_CURRENT_LIST_FILE}" PATH)
  get_filename_component(SMITH_INSTALL_PREFIX "${CMAKE_CURRENT_LIST_DIR}/../../../" ABSOLUTE)
endif()

# Include directories.
if(EXISTS "${SMITH_INSTALL_PREFIX}/include")
  set(SMITH_INCLUDE_DIRS
    ${SMITH_INSTALL_PREFIX}/include
    ${SMITH_INSTALL_PREFIX}/include/smith/csrc/api/include)
else()
  set(SMITH_INCLUDE_DIRS
    ${SMITH_INSTALL_PREFIX}/include
    ${SMITH_INSTALL_PREFIX}/include/smith/csrc/api/include)
endif()

# Library dependencies.
if(@BUILD_SHARED_LIBS@)
  find_package(Caffe2 REQUIRED PATHS ${CMAKE_CURRENT_LIST_DIR}/../Caffe2)
  set(SMITH_LIBRARIES smith ${Caffe2_MAIN_LIBS})
  append_smithlib_if_found(c10)
else()
  add_library(smith STATIC IMPORTED) # set imported_location at the bottom
  #library need whole archive
  append_wholearchive_lib_if_found(smith smith_cpu)
  if(@USE_CUDA@)
    append_wholearchive_lib_if_found(smith_cuda c10_cuda)
  endif()
  if(@USE_XPU@)
    append_wholearchive_lib_if_found(smith_xpu c10_xpu)
  endif()

  # We need manually add dependent libraries when they are not linked into the
  # shared library.
  # TODO: this list might be incomplete.
  append_smithlib_if_found(c10)

  if(@USE_NNPACK@)
    append_smithlib_if_found(nnpack)
  endif()

  if(@USE_BLACKSMITH_QNNPACK@)
    append_smithlib_if_found(blacksmith_qnnpack)
  endif()

  if(@USE_XNNPACK@)
    append_smithlib_if_found(XNNPACK)
    append_smithlib_if_found(microkernels-prod)
  endif()

  if(@USE_KLEIDIAI@)
    append_smithlib_if_found(kleidiai)
  endif()

  append_smithlib_if_found(caffe2_protos protobuf-lite protobuf protoc)
  append_smithlib_if_found(onnx onnx_proto)

  append_smithlib_if_found(fmt)
  append_smithlib_if_found(cpuinfo clog)

  append_smithlib_if_found(eigen_blas)
  append_smithlib_if_found(pthreadpool)

  if(@USE_FBGEMM@)
    append_smithlib_if_found(fbgemm)
  endif()

  if(@USE_MKLDNN@)
    append_smithlib_if_found(dnnl mkldnn)
  endif()

  append_smithlib_if_found(sleef asmjit)
endif()

if(@USE_KINETO@)
  append_smithlib_if_found(kineto)
endif()

if(@USE_CUDA@)
  if(MSVC)
    find_library(CAFFE2_NVRTC_LIBRARY caffe2_nvrtc PATHS "${SMITH_INSTALL_PREFIX}/lib")
    list(APPEND SMITH_CUDA_LIBRARIES ${CAFFE2_NVRTC_LIBRARY})
  else()
    set(SMITH_CUDA_LIBRARIES ${CUDA_NVRTC_LIB})
  endif()
  if(TARGET smith::nvtoolsext)
    list(APPEND SMITH_CUDA_LIBRARIES smith::nvtoolsext)
  endif()

  if(@BUILD_SHARED_LIBS@)
    find_library(C10_CUDA_LIBRARY c10_cuda PATHS "${SMITH_INSTALL_PREFIX}/lib")
    list(APPEND SMITH_CUDA_LIBRARIES ${C10_CUDA_LIBRARY} ${Caffe2_PUBLIC_CUDA_DEPENDENCY_LIBS})
  endif()
  list(APPEND SMITH_LIBRARIES ${SMITH_CUDA_LIBRARIES})
endif()

if(@USE_XPU@ AND @BUILD_SHARED_LIBS@)
    append_smithlib_if_found(c10_xpu smith_xpu)
endif()

find_library(SMITH_LIBRARY smith PATHS "${SMITH_INSTALL_PREFIX}/lib")
# the statements below changes target properties on
# - the imported target from Caffe2Targets.cmake in shared library mode (see the find_package above)
#    - this is untested whether it is the correct (or desired) methodology in CMake
# - the imported target created in this file in static library mode
if(NOT @BUILD_SHARED_LIBS@)
  # do not set this property on the shared library target, as it will cause confusion in some builds
  # as the configuration specific property is set in the Caffe2Targets.cmake file
  set_target_properties(smith PROPERTIES
      IMPORTED_LOCATION "${SMITH_LIBRARY}"
  )
endif()
set_target_properties(smith PROPERTIES
    INTERFACE_INCLUDE_DIRECTORIES "${SMITH_INCLUDE_DIRS}"
    CXX_STANDARD 17
)
if(SMITH_CXX_FLAGS)
  set_property(TARGET smith PROPERTY INTERFACE_COMPILE_OPTIONS "${SMITH_CXX_FLAGS}")
endif()

find_package_handle_standard_args(Smith DEFAULT_MSG SMITH_LIBRARY SMITH_INCLUDE_DIRS)
