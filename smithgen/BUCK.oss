python_library(
    name = "smithgen",
    srcs = glob(
        ["**/*.py"],
    ),
    base_module = "smithgen",
    visibility = ["PUBLIC"],
    deps = [
        "//third_party:pyyaml",
        "//third_party:typing-extensions",
    ],
)

python_binary(
    name = "gen",
    main_module = "smithgen.gen",
    visibility = [
        "PUBLIC",
    ],
    deps = [
        ":smithgen",
    ],
)
